[sub_resource type="Gradient" id="Gradient_4c6g5"]

[sub_resource type="GDScript" id="GDScript_n3o5m"]
script/source = "extends Line2D
@export var max_points: int = 50
@export var min_distance: float = 2.0

func _ready() -> void:
	set_as_top_level(true)
	global_position = Vector2.ZERO
	global_rotation = 0.0

func _physics_process(delta: float) -> void:
	global_position = Vector2.ZERO
	global_rotation = 0.0

	var new_point = get_parent().global_position

	if get_point_count() == 0 or new_point.distance_to(get_point_position(get_point_count() - 1)) > min_distance:
		add_point(new_point)

	while get_point_count() > max_points:
		remove_point(0)
"

[node name="trail" type="Line2D"]
gradient = SubResource("Gradient_4c6g5")
texture = ExtResource("1_4c6g5")
texture_mode = 1
script = SubResource("GDScript_n3o5m")
